# Copiar este archivo como ".env" y completar con los valores reales.
# Nunca subir el archivo ".env" real al repositorio.

# Datos del proyecto de Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_KEY=

# Secreto usado para firmar los tokens de sesion (JWT). Cualquier cadena larga y unica.
JWT_SECRET=

# Puerto donde corre el servidor Express
PORT=3000
